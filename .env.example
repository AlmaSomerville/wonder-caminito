# Copy this file to .env for your computer. NEVER commit .env (the .gitignore blocks it).
# On Vercel these same names go in Project -> Settings -> Environment Variables.

# Database. On YOUR COMPUTER use the value Vercel calls DATABASE_URL_UNPOOLED (direct connection).
# On Vercel nothing to do: the Neon integration already set DATABASE_URL for you.
DATABASE_URL="postgresql://..."

# Any long random string (signs login cookies). Generate one at https://generate-secret.vercel.app/32
AUTH_SECRET="paste-a-long-random-string"

# Nati's password for /admin
ADMIN_PASSWORD="choose-a-strong-password"

# The site's own public address, no trailing slash. Used for Google, the sitemap and partner tracking links.
# Locally: http://localhost:3000   On Vercel now: https://wonder-caminito.vercel.app   Later: https://wondercaminito.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Nati's WhatsApp, digits only with country code
NEXT_PUBLIC_WHATSAPP="34604411426" 
